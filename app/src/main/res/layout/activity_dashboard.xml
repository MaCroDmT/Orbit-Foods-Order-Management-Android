<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary_dark"
        android:padding="@dimen/screen_padding"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="@dimen/logo_width_sm"
            android:layout_height="@dimen/logo_height_sm"
            android:src="@drawable/logo_eng"
            android:scaleType="fitCenter"
            android:layout_marginBottom="@dimen/space_sm"/>

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="স্বাগতম!"
            android:textSize="@dimen/text_lg"
            android:textColor="#B0D4E3"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Accent line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/accent"/>

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মেনু"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_hint"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md"/>

            <!-- Products Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/bg_card"
                android:layout_marginBottom="@dimen/space_md">

                <LinearLayout
                    android:id="@+id/btnProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/primary"
                        android:gravity="center"
                        android:layout_marginEnd="@dimen/space_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📦"
                            android:textSize="24sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="পণ্য ব্যবস্থাপনা"
                            android:textSize="@dimen/text_lg"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="পণ্য যোগ, সম্পাদনা ও মুছুন"
                            android:textSize="@dimen/text_sm"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="28sp"
                        android:textColor="@color/primary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Orders Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/bg_card"
                android:layout_marginBottom="@dimen/space_xl">

                <LinearLayout
                    android:id="@+id/btnOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/success"
                        android:gravity="center"
                        android:layout_marginEnd="@dimen/space_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋"
                            android:textSize="24sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="অর্ডার ব্যবস্থাপনা"
                            android:textSize="@dimen/text_lg"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="অর্ডার তৈরি, দেখুন ও PDF ডাউনলোড"
                            android:textSize="@dimen/text_sm"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="28sp"
                        android:textColor="@color/success"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Logout -->
            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="লগআউট করুন"
                android:textSize="@dimen/text_md"
                android:textColor="@color/error"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="@dimen/space_md"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>