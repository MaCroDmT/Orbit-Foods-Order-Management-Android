<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8F5">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#5A939E"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="অর্ডার তালিকা"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <!-- Order count badge -->
        <TextView
            android:id="@+id/tvOrderCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="০ টি অর্ডার"
            android:textSize="14sp"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Order List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <!-- Empty state message -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="কোনো অর্ডার নেই।\nনতুন অর্ডার তৈরি করুন।"
        android:textSize="18sp"
        android:textColor="#888888"
        android:gravity="center"
        android:visibility="gone"/>

    <!-- New Order Button -->
    <Button
        android:id="@+id/btnNewOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ নতুন অর্ডার তৈরি করুন"
        android:textSize="18sp"
        android:backgroundTint="#5A939E"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:layout_margin="12dp"/>

</LinearLayout>